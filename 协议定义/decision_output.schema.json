{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_output.schema.json",
  "title": "DecisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "confidence", "reason", "source"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "STOP",
        "WAIT",
        "SLOW_DOWN",
        "KEEP_CENTER",
        "TURN_LEFT",
        "TURN_RIGHT",
        "BYPASS_LEFT",
        "BYPASS_RIGHT"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["rule_engine", "llm", "fusion"]
    }
  }
}
